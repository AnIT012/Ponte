{
  "scopeName": "source.ponte",
  "name": "Ponte",
  "patterns": [
    {
      "name": "invalid.blocking.ponte",
      "match": "##.*$"
    },
    {
      "name": "comment.line.ponte",
      "match": "(?<![0-9A-Fa-f])#(?![0-9A-Fa-f]{3,8}\\b).*$"
    },
    {
      "name": "string.quoted.ponte",
      "match": "\"[^\"]*\""
    },
    {
      "name": "keyword.declaration.ponte",
      "match": "^(?:\\s*)(thing|flow|list|match|rule|relate|action|group|tbd|never|scene|look|part|style|input|words|who|change|connect|shape|use)\\b"
    },
    {
      "name": "keyword.guard.ponte",
      "match": "\\b(never|else|tbd|gone|limit|confirm)\\b|>|\\bgone\\["
    },
    {
      "name": "keyword.clause.ponte",
      "match": "^\\s+(of|where|sort|when|do|why|in|out|example|by|ask|how|given|at|says|taps|gets|expect|title|sub|mark|button|lead|heading|search|group|take|empty|show|top|main|side|bottom|over|can|gives|does|needs|limit|add|rename|remove)\\b"
    },
    {
      "name": "storage.type.ponte",
      "match": "\\b(text|number|count|money|percent|date|monthday|duration|file|image|pdf)\\b|\\[[^\\]]*\\]"
    },
    {
      "name": "entity.name.ponte",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    {
      "name": "constant.numeric.ponte",
      "match": "\\b\\d+(?:[:/.]\\d+)*\\b(?:\\s+(?:days?|hours?|minutes?|seconds?|weeks?))?"
    },
    {
      "name": "keyword.operator.ponte",
      "match": "->|\\|"
    }
  ]
}