# std/date FindMonthDay の中身。2つ以上あったら決めない（missing）

do
  clean = normalize text
  hits  = find all MonthDay in clean
  kind[one | none | many] = match count of hits
    1    -> one
    0    -> none
    else -> many
  answer = match kind
    one  -> found monthday of first of hits
    none -> missing
    many -> missing

shape MonthDay
  month  digits 1..2
  "/"
  day    digits 1..2
  maybe  "(" any 1 ")"
  maybe  space
  maybe  hour digits 1..2 ":" minute digits 2
