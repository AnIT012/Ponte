# 就活Hub — ブラウザで動かす版（python -m lang run spec/hub_app.lang）
# 仕様書 v0.2 の付録に、画面（タブ・ボード・カレンダー・グラフ・詳しく・メニュー）と見た目を足したもの

thing Application
  company   text
  deadline  monthday
  memo      text
  owner     User   gone[remove too]
  status[draft | submitted | passed | failed]

thing User
  name text

flow Application.status
  draft -> submitted -> passed | failed
  failed > passed

who
  user  can see    Application where owner is me
  user  can change Application where owner is me
  user  can see    User where it is me

list DueSoon
  of     Application
  where  status is draft
  where  deadline within 3 days
  sort   deadline

list Mine
  of    Application
  sort  deadline

match Application.status to color
  draft     -> orange
  submitted -> blue
  passed    -> green
  failed    -> gray
  else      -> gray

match Application.status to icon
  draft     -> draft
  submitted -> send
  passed    -> trophy
  failed    -> x

connect Gmail
  gives  new message  Message
  needs  key GMAIL_TOKEN

action ExtractDeadline
  in       mail text
  out      found monthday | missing
  example  "10/15(木)12:00まで"            -> found 10/15 12:00
  example  "【締切9/24 23:59】"            -> found 9/24 23:59
  example  "来週中にご提出ください"        -> missing
  example  "9/24 23:59 または 9/30 23:59"  -> missing
  never    guess the year
  never    depend on width
  else     ask user
  by       ai

rule ReadMail
  why   メールの締切を自動で拾うため
  when  Gmail gives new message
  do    ExtractDeadline

rule Remind
  why   締切を落とさないため
  when  every day at 21:00
  do    notify owner each of DueSoon
  example
    given   Application
      company   "Osaka Gas"
      deadline  "9/24 23:59"
      status    draft
    at      "9/21 21:00"
    expect  notify "Osaka Gas"

rule MarkSubmitted
  when  user taps submitted-button on Application
  do    move this to submitted
  example
    given Application
      company  "Osaka Gas"
      status   draft
    taps submitted-button on Application
      company "Osaka Gas"
    expect Application is submitted
      company "Osaka Gas"

rule MarkPassed
  when  user taps passed-button on Application
  do    move this to passed
  example
    given Application
      company  "Osaka Gas"
      status   submitted
    taps passed-button on Application
      company "Osaka Gas"
    expect Application is passed
      company "Osaka Gas"

rule MarkFailed
  when  user taps failed-button on Application
  do    move this to failed
  example
    given Application
      company  "Osaka Gas"
      status   submitted
    taps failed-button on Application
      company "Osaka Gas"
    expect Application is failed
      company "Osaka Gas"

rule OpenAdd
  when  user taps add on Home
  do    go AddApplication
  example
    taps    add on Home
    expect  scene AddApplication

rule OpenDetail
  when  user taps card on Application
  do    go Detail with this
  example
    given Application
      company  "Osaka Gas"
      status   draft
    taps card on Application
      company "Osaka Gas"
    expect scene Detail

rule OpenEdit
  when  user taps edit-button on Application
  do    go EditApplication with this
  example
    given Application
      company  "Osaka Gas"
      status   draft
    taps edit-button on Application
      company "Osaka Gas"
    expect scene EditApplication

rule Back
  when  user taps back on Detail
  do    go Home
  example
    taps    back on Detail
    expect  scene Home

relate
  MarkSubmitted > Remind

# ---- 画面 ----

scene Home
  tab[soon | all | board | calendar] = soon
  menu[closed | open] = closed
  top     Header
  top     tabs tab
  top     notices
  top     button menu-button named メニュー icon menu toggle menu
  main    match tab
    soon     -> DueSoon as cards
    all      -> Mine as list
    board    -> Mine as board
    calendar -> Mine as calendar
  side    Mine as chart
  bottom  button add named 応募を追加 icon plus
  over    match menu
    open   -> Menu as sheet
    closed -> nothing

scene Detail
  top   Header
  top   button back named 戻る icon back
  main  this as detail

match tab to icon
  soon     -> clock
  all      -> list
  board    -> board
  calendar -> calendar

flow scene
  Home -> AddApplication -> Home
  Home -> Detail -> Home
  Detail -> EditApplication -> Detail

part Header
  show  text "就活Hub"
  show  text "締切と選考をひとつに"

part Menu
  show  text "メニュー"
  show  text "通知は毎日21時。締切が3日以内の下書きをお知らせします"

part DeadlineBadge
  in    deadline monthday
  do
    left = days until deadline
    urgency[over | today | soon | later] = match left
      ..-1 -> over
      0    -> today
      1..3 -> soon
      else -> later
    label = match urgency
      over  -> "締切を過ぎました"
      today -> "今日が締切"
      soon  -> "あと{left}日"
      later -> "あと{left}日"
  show  text "{deadline} ・ {label}"
  mark  urgency

match DeadlineBadge.urgency to color
  over  -> gray
  today -> red
  soon  -> orange
  later -> blue

look DueSoon as cards
  heading  "3日以内に締切"
  lead     company
  title    company
  sub      DeadlineBadge of deadline
  mark     color of status
  button   submitted-button named 提出した icon send
  empty    "3日以内に締切の下書きはありません" button add named 応募を追加 icon plus

look Mine as list
  search  company, memo
  group   by status
  lead    company
  title   company
  sub     DeadlineBadge of deadline
  empty   "まだ応募がありません" button add named 応募を追加 icon plus

look Application as detail
  lead    company
  title   company
  sub     DeadlineBadge of deadline
  mark    color of status
  button  submitted-button named 提出した icon send
  button  passed-button    named 通過 icon trophy
  button  failed-button    named 不合格 icon x confirm "不合格にしますか？"
  button  edit-button      named 編集 icon edit

input AddApplication
  company   required
  deadline  required
  memo

input EditApplication
  company   required
  deadline  required
  memo

style theme
  color   main  #4F46E5
  radius  14

style DueSoon
  card     pad 18
  title    size 18, bold
  enter    slide 240ms
  reorder  slide 220ms

style Application
  passed-button  tone good
  failed-button  tone danger
  edit-button    tone quiet

