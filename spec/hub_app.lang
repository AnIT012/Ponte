# 就活Hub — ブラウザで動かす版（python -m lang run spec/hub_app.lang）
# hub_ready.lang に、画面の部品（Header / EmptyNote）と「追加」ボタンの移動、一覧と見た目を足したもの

thing Application
  company   text
  deadline  monthday
  owner     User   gone[remove too]
  status[draft | submitted | passed | failed]

thing User
  name  text

flow Application.status
  draft -> submitted -> passed | failed
  failed > passed

who
  user   can see    Application where owner is me
  user   can change Application where owner is me
  user   can see    User where it is me

list DueSoon
  of    Application
  where status is draft
  where deadline within 3 days
  sort  deadline

list Mine
  of    Application
  sort  deadline

match Application.status to color
  draft     -> red
  submitted -> gray
  passed    -> blue
  failed    -> gray

connect Gmail
  gives  new message  Message
  needs  key GMAIL_TOKEN

action ExtractDeadline
  in      mail text
  out     found monthday | missing
  example "10/15(木)12:00まで"            -> found 10/15 12:00
  example "【締切9/24 23:59】"            -> found 9/24 23:59
  example "来週中にご提出ください"        -> missing
  example "9/24 23:59 または 9/30 23:59"  -> missing
  never   guess the year
  else    ask user
  by      ai

rule ReadMail
  why   メールの締切を自動で拾うため
  when  Gmail gives new message
  do    ExtractDeadline

rule Remind
  why   締切を落とさないため
  when  every day at 21:00
  do    notify each of DueSoon
  example
    given   Application(company "Osaka Gas", deadline "9/24 23:59", status draft)
    at      "9/21 21:00"
    expect  notify "Osaka Gas"

rule MarkSubmitted
  when  user taps submitted-button on DueSoon
  do    move this to submitted
  example
    given   Application(company "Osaka Gas", status draft)
    taps    submitted-button on Application(company "Osaka Gas")
    expect  Application(company "Osaka Gas") is submitted

rule MarkPassed
  when  user taps passed-button on Mine
  do    move this to passed
  example
    given   Application(company "Osaka Gas", status submitted)
    taps    passed-button on Application(company "Osaka Gas")
    expect  Application(company "Osaka Gas") is passed

rule MarkFailed
  when  user taps failed-button on Mine
  do    move this to failed
  example
    given   Application(company "Osaka Gas", status submitted)
    taps    failed-button on Application(company "Osaka Gas")
    expect  Application(company "Osaka Gas") is failed

rule OpenAdd
  when  user taps add on Home
  do    go AddApplication
  example
    taps    add on Home
    expect  scene AddApplication

relate
  MarkSubmitted > Remind

scene Home
  top     Header
  main    match count of DueSoon
            0    -> EmptyNote
            else -> DueSoon as cards
  side    Mine as list
  bottom  button add named 応募を追加

flow scene
  Home -> AddApplication

part Header
  show  text "就活Hub"

part EmptyNote
  show  text "3日以内に締切の下書きはありません"

look DueSoon as cards
  title   company
  sub     deadline
  mark    color of status
  button  submitted-button named 提出した

look Mine as list
  title   company
  sub     deadline
  mark    color of status
  button  passed-button named 通過
  button  failed-button named 不合格

input AddApplication
  company   required
  deadline  required

style DueSoon
  card   round 14, shadow soft, pad 18
  title  size 18, bold
  gap    14
